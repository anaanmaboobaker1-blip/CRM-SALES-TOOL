# Application Port
PORT=5000

# Client (Frontend) URL for CORS
CLIENT_URL=http://localhost:5173

# Database Connection URL (Prisma support SQLite/PostgreSQL)
# For SQLite (default development):
DATABASE_URL="file:./dev.db"

# For PostgreSQL (production fallback):
# DATABASE_URL="postgresql://username:password@localhost:5432/sme_crm?schema=public"

# JWT Token Secret
JWT_SECRET="sme_crm_secret_key_change_me_in_production"
